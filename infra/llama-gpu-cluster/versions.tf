# Terraform sketch: Kubernetes + GPU LLaMA stack
# WARNING: See README.md — not fully apply-ready (kubeconfig + real cloud node pools required).

terraform {
  required_version = ">= 1.0"
  required_providers {
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.20"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.10"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.5"
    }
  }
}
